{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "paths": {
            "@shared/*": ["./src/shared/*"],
            "@modules/*": ["./src/modules/*"],
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}
